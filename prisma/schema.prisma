generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  GERENTE
  FUNCIONARIO
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           UserRole      @default(FUNCIONARIO)
  isSuperAdmin   Boolean       @default(false)
  allowedModules String[]      @default([])
  locale         String        @default("pt-BR")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  pushSubscriptions   PushSubscription[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// ---------- Organizações (clientes da JHV) ----------

model Organization {
  id              String   @id @default(cuid())
  name            String
  cpfCnpj         String?
  email           String?
  phone           String?
  address         String?
  zipCode         String?
  streetNumber    String?
  neighborhood    String?
  city            String?
  state           String?
  allowedModules  String[] @default([])
  // Só afeta como valores monetários são EXIBIDOS nas telas (símbolo,
  // separador) — não converte valores nem muda como o boleto/Mercado
  // Pago funciona, que continua sendo especificamente em BRL.
  currency        String   @default("BRL")
  active          Boolean  @default(true)
  mpAccessToken   String?
  resendApiKey    String?
  resendFromEmail String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users              User[]
  whatsappConnection WhatsappConnection?
  whatsappMessages   WhatsappMessage[]

  owners        Owner[]
  employees     Employee[]
  veterinarians Veterinarian[]
  farriers      Farrier[]
  instructors   Instructor[]
  handlers      Handler[]
  clients       Client[]
  suppliers     Supplier[]
  animals       Animal[]

  trainingSessions    TrainingSession[]
  animalDiets         AnimalDiet[]
  equineHealthRecords EquineHealthRecord[]
  stalls              Stall[]
  agendaEvents        AgendaEvent[]
  competitions        Competition[]
  transports          Transport[]
  financialEntries    FinancialEntry[]
  animalTransactions  AnimalTransaction[]
  piquetes            Piquete[]
  contracts           Contract[]

  stockItems StockItem[]
  machines   Machine[]
  mechanics  Mechanic[]

  purchaseRequests PurchaseRequest[]
  quotations       Quotation[]
  purchaseOrders   PurchaseOrder[]

  costCenters    CostCenter[]
  chartAccounts  ChartAccount[]
  journalEntries JournalEntry[]

  financeEntries    FinanceEntry[]
  recurringBillings RecurringBilling[]

  talhoes  Talhao[]
  storages Storage[]

  lotes               Lote[]
  pastures            Pasture[]
  livestockAnimals    LivestockAnimal[]
  managementMovements ManagementMovement[]

  auditLogs         AuditLog[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  properties        Property[]
  apiKeys           ApiKey[]

  mudaEspecies           MudaEspecie[]
  viveiros               Viveiro[]
  mudaLotes              MudaLote[]
  mudaLoteInsumos        MudaLoteInsumo[]
  mudaLoteIrrigacoes     MudaLoteIrrigacao[]
  mudaLoteFitossanidades MudaLoteFitossanidade[]
  mudaLoteMaoDeObra      MudaLoteMaoDeObra[]

  produtores           Produtor[]
  propriedadesProdutor PropriedadeProdutor[]
  responsaveisTecnicos ResponsavelTecnico[]
  amostras             Amostra[]

  metodosAnaliticos  MetodoAnalitico[]
  equipamentosLab    Equipamento[]
  resultados         Resultado[]
  controlesQualidade ControleQualidade[]

  normasReferencia        NormaReferencia[]
  laudosTecnicos          LaudoTecnico[]
  pedidosAnalise          PedidoAnalise[]
  acreditacoesLaboratorio AcreditacaoLaboratorio[]

  auditoriasAgricolas AuditoriaAgricola[]
  naoConformidades    NaoConformidade[]

  @@map("organizations")
}

// ---------- Cadastro: propriedades (fazendas) ----------
// Uma organização pode ter mais de uma fazenda/propriedade. Ligação
// opcional: hoje só as entidades geográficas (Talhão, Pastagem, Piquete)
// referenciam a propriedade — os demais módulos (financeiro, RH, estoque
// etc.) continuam escopados só por organização, não por propriedade
// individual, pra não precisar refazer o retrofit inteiro de novo.
model Property {
  id        String   @id @default(cuid())
  name      String
  code      String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  talhoes  Talhao[]
  pastures Pasture[]
  piquetes Piquete[]
  viveiros Viveiro[]

  @@map("properties")
}

// ---------- Cadastro: pessoas ----------

model Owner {
  id        String   @id @default(cuid())
  name      String
  cpfCnpj   String?  @unique
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  animals Animal[]

  @@map("owners")
}

model Employee {
  id            String    @id @default(cuid())
  name          String
  cpf           String?   @unique
  role          String?
  phone         String?
  email         String?
  address       String?
  admissionDate DateTime?
  salary        Decimal?  @db.Decimal(12, 2)
  active        Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  attendances            Attendance[]
  schedules              Schedule[]
  trainings              Training[]
  epiIssuances           EpiIssuance[]
  mudaLotes              MudaLote[]
  mudaLoteIrrigacoes     MudaLoteIrrigacao[]
  mudaLoteFitossanidades MudaLoteFitossanidade[]
  mudaLoteMaoDeObra      MudaLoteMaoDeObra[]
  responsavelTecnico     ResponsavelTecnico?
  resultadosAnalise      Resultado[]

  @@map("employees")
}

model Veterinarian {
  id        String   @id @default(cuid())
  name      String
  cpf       String?  @unique
  crmv      String?
  phone     String?
  email     String?
  specialty String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("veterinarians")
}

model Farrier {
  id        String   @id @default(cuid())
  name      String
  cpf       String?  @unique
  phone     String?
  email     String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("farriers")
}

model Instructor {
  id        String   @id @default(cuid())
  name      String
  cpf       String?  @unique
  phone     String?
  email     String?
  specialty String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  trainingSessions TrainingSession[]

  @@map("instructors")
}

model Handler {
  id        String   @id @default(cuid())
  name      String
  cpf       String?  @unique
  phone     String?
  email     String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("handlers")
}

model Client {
  id           String   @id @default(cuid())
  name         String
  cpfCnpj      String?  @unique
  email        String?
  phone        String?
  address      String?
  zipCode      String?
  streetNumber String?
  neighborhood String?
  city         String?
  state        String?
  notes        String?
  locale       String   @default("pt-BR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  financialEntries  FinancialEntry[]
  financeEntries    FinanceEntry[]
  recurringBillings RecurringBilling[]
  contracts         Contract[]
  whatsappMessages  WhatsappMessage[]

  @@map("clients")
}

model Supplier {
  id                 String   @id @default(cuid())
  name               String
  cpfCnpj            String?  @unique
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  productsOrServices String?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  quotations     Quotation[]
  purchaseOrders PurchaseOrder[]
  financeEntries FinanceEntry[]
  mudaEspecies   MudaEspecie[]

  @@map("suppliers")
}

// ---------- Cadastro: animais ----------

enum AnimalSexo {
  MACHO
  FEMEA
  CASTRADO
}

enum AnimalStatus {
  ATIVO
  VENDIDO
  EMPRESTADO
  OBITO
  INATIVO
}

model Animal {
  id             String       @id @default(cuid())
  name           String
  registro       String?      @unique
  especie        String       @default("Equino")
  raca           String?
  sexo           AnimalSexo?
  pelagem        String?
  dataNascimento DateTime?
  microchip      String?      @unique
  peso           Decimal?     @db.Decimal(8, 2)
  altura         Decimal?     @db.Decimal(5, 2)
  status         AnimalStatus @default(ATIVO)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  ownerId String?
  owner   Owner?  @relation(fields: [ownerId], references: [id])

  paiId         String?
  pai           Animal?  @relation("AnimalPai", fields: [paiId], references: [id])
  filhosComoPai Animal[] @relation("AnimalPai")

  maeId         String?
  mae           Animal?  @relation("AnimalMae", fields: [maeId], references: [id])
  filhosComoMae Animal[] @relation("AnimalMae")

  photos    AnimalPhoto[]
  documents AnimalDocument[]

  trainingSessions TrainingSession[]
  diets            AnimalDiet[]
  stallEvents      StallEvent[]
  currentStall     Stall?               @relation("StallOccupant")
  piqueteEvents    PiqueteEvent[]
  currentPiquete   Piquete?             @relation("PiqueteOccupant")
  agendaEvents     AgendaEvent[]
  competitions     Competition[]
  transportLinks   TransportAnimal[]
  financialEntries FinancialEntry[]
  transactions     AnimalTransaction[]
  healthRecords    EquineHealthRecord[]
  contracts        Contract[]

  @@map("animals")
}

model AnimalPhoto {
  id        String   @id @default(cuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime @default(now())

  @@map("animal_photos")
}

model AnimalDocument {
  id        String   @id @default(cuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String?
  createdAt DateTime @default(now())

  @@map("animal_documents")
}

// ---------- Hípica ----------

enum ExerciseType {
  EXERCICIO_GERAL
  SALTO
  TAMBOR
  MARCHA
  CORRIDA
  ADESTRAMENTO
  OUTRO
}

enum Intensity {
  LEVE
  MODERADA
  INTENSA
}

model TrainingSession {
  id           String       @id @default(cuid())
  animalId     String
  animal       Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
  instructorId String?
  instructor   Instructor?  @relation(fields: [instructorId], references: [id])
  date         DateTime
  exerciseType ExerciseType @default(EXERCICIO_GERAL)
  durationMin  Int?
  intensity    Intensity?
  evolution    String?
  notes        String?
  createdAt    DateTime     @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("training_sessions")
}

model AnimalDiet {
  id                 String   @id @default(cuid())
  animalId           String
  animal             Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  startDate          DateTime @default(now())
  concentradoKg      Decimal? @db.Decimal(6, 2)
  fenoKg             Decimal? @db.Decimal(6, 2)
  silagemKg          Decimal? @db.Decimal(6, 2)
  suplementos        String?
  quantidadeDiariaKg Decimal? @db.Decimal(6, 2)
  custoDiario        Decimal? @db.Decimal(10, 2)
  active             Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("animal_diets")
}

enum EquineHealthRecordType {
  MEDICAMENTO
  VACINA
  SORO
  VERMIFUGO
  FERRADURA
  CASQUEAMENTO
  OUTRO
}

model EquineHealthRecord {
  id           String                 @id @default(cuid())
  animalId     String
  animal       Animal                 @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type         EquineHealthRecordType
  date         DateTime
  product      String?
  nextDoseDate DateTime?
  notes        String?
  createdAt    DateTime               @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("equine_health_records")
}

enum StallStatus {
  LIVRE
  OCUPADA
  LIMPEZA
  MANUTENCAO
}

model Stall {
  id        String      @id @default(cuid())
  code      String      @unique
  location  String?
  capacity  Int         @default(1)
  status    StallStatus @default(LIVRE)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  currentAnimalId String? @unique
  currentAnimal   Animal? @relation("StallOccupant", fields: [currentAnimalId], references: [id])

  events    StallEvent[]
  contracts Contract[]

  @@map("stalls")
}

enum StallEventType {
  OCUPACAO
  DESOCUPACAO
  LIMPEZA
  MANUTENCAO
  TROCA
}

model StallEvent {
  id        String         @id @default(cuid())
  stallId   String
  stall     Stall          @relation(fields: [stallId], references: [id], onDelete: Cascade)
  type      StallEventType
  date      DateTime       @default(now())
  animalId  String?
  animal    Animal?        @relation(fields: [animalId], references: [id])
  notes     String?
  createdAt DateTime       @default(now())

  @@map("stall_events")
}

enum AgendaEventType {
  FERRADOR
  VETERINARIO
  VACINA
  COMPETICAO
  TRANSPORTE
  OUTRO
}

enum AgendaEventStatus {
  AGENDADO
  CONCLUIDO
  CANCELADO
}

model AgendaEvent {
  id        String            @id @default(cuid())
  title     String
  type      AgendaEventType   @default(OUTRO)
  date      DateTime
  animalId  String?
  animal    Animal?           @relation(fields: [animalId], references: [id])
  status    AgendaEventStatus @default(AGENDADO)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("agenda_events")
}

model Competition {
  id        String   @id @default(cuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime
  location  String?
  category  String?
  result    String?
  notes     String?
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("competitions")
}

model Transport {
  id          String   @id @default(cuid())
  date        DateTime
  origin      String?
  destination String?
  driver      String?
  vehicle     String?
  notes       String?
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  animals TransportAnimal[]

  @@map("transports")
}

model TransportAnimal {
  id          String    @id @default(cuid())
  transportId String
  transport   Transport @relation(fields: [transportId], references: [id], onDelete: Cascade)
  animalId    String
  animal      Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@unique([transportId, animalId])
  @@map("transport_animals")
}

enum FinancialEntryType {
  MENSALIDADE
  HOSPEDAGEM
  TREINAMENTO
  VETERINARIO
  MEDICAMENTO
  OUTRO
}

enum FinancialEntryStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

model FinancialEntry {
  id          String               @id @default(cuid())
  type        FinancialEntryType   @default(OUTRO)
  description String
  amount      Decimal              @db.Decimal(12, 2)
  dueDate     DateTime?
  paidDate    DateTime?
  status      FinancialEntryStatus @default(PENDENTE)
  animalId    String?
  animal      Animal?              @relation(fields: [animalId], references: [id])
  clientId    String?
  client      Client?              @relation(fields: [clientId], references: [id])
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("financial_entries")
}

enum AnimalTransactionType {
  COMPRA
  VENDA
  LEILAO
}

model AnimalTransaction {
  id               String                @id @default(cuid())
  animalId         String
  animal           Animal                @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type             AnimalTransactionType
  date             DateTime
  value            Decimal               @db.Decimal(12, 2)
  commission       Decimal?              @db.Decimal(12, 2)
  counterpartyName String?
  notes            String?
  createdAt        DateTime              @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("animal_transactions")
}

// ---------- Pecuária ----------

enum LivestockCategory {
  CORTE
  LEITE
  CONFINAMENTO
  CRIA
  RECRIA
  ENGORDA
  REPRODUTOR
  OUTRO
}

enum LivestockStatus {
  ATIVO
  VENDIDO
  ABATIDO
  OBITO
  INATIVO
}

model Lote {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String?
  category    LivestockCategory?
  description String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animals   LivestockAnimal[]
  feedings  LivestockFeeding[]
  movements ManagementMovement[]

  @@map("lotes")
}

enum PastureRotationStatus {
  EM_USO
  DESCANSO
}

model Pasture {
  id             String                @id @default(cuid())
  code           String                @unique
  name           String?
  areaHectares   Decimal?              @db.Decimal(10, 2)
  capacityHead   Int?
  rotationStatus PastureRotationStatus @default(EM_USO)
  grassHeightCm  Decimal?              @db.Decimal(5, 2)
  boundary       Json?
  notes          String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  animals LivestockAnimal[]

  @@map("pastures")
}

model LivestockAnimal {
  id             String            @id @default(cuid())
  brinco         String            @unique
  rfid           String?           @unique
  name           String?
  sexo           AnimalSexo?
  raca           String?
  category       LivestockCategory @default(OUTRO)
  dataNascimento DateTime?
  pesoAtual      Decimal?          @db.Decimal(8, 2)
  status         LivestockStatus   @default(ATIVO)
  notes          String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  loteId String?
  lote   Lote?   @relation(fields: [loteId], references: [id])

  pastureId String?
  pasture   Pasture? @relation(fields: [pastureId], references: [id])

  weighings       WeightRecord[]
  healthRecords   HealthRecord[]
  reproductions   Reproduction[]
  milkProductions MilkProduction[]
  movements       ManagementMovement[]

  @@map("livestock_animals")
}

enum ReproductionMethod {
  IA
  MONTA_NATURAL
}

enum DiagnosisResult {
  PRENHE
  VAZIA
  INDEFINIDO
}

model Reproduction {
  id                String             @id @default(cuid())
  animalId          String
  animal            LivestockAnimal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  method            ReproductionMethod
  date              DateTime
  diagnosisDate     DateTime?
  diagnosisResult   DiagnosisResult?
  expectedBirthDate DateTime?
  birthDate         DateTime?
  weaningDate       DateTime?
  notes             String?
  createdAt         DateTime           @default(now())

  @@map("reproductions")
}

enum HealthRecordType {
  VACINA_BRUCELOSE
  VACINA_AFTOSA
  CARRAPATICIDA
  VERMIFUGO
  TRATAMENTO
  OUTRO
}

model HealthRecord {
  id           String           @id @default(cuid())
  animalId     String
  animal       LivestockAnimal  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  type         HealthRecordType
  date         DateTime
  product      String?
  nextDoseDate DateTime?
  notes        String?
  createdAt    DateTime         @default(now())

  @@map("health_records")
}

model WeightRecord {
  id        String          @id @default(cuid())
  animalId  String
  animal    LivestockAnimal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  date      DateTime
  weightKg  Decimal         @db.Decimal(8, 2)
  notes     String?
  createdAt DateTime        @default(now())

  @@map("weight_records")
}

enum MilkShift {
  MANHA
  TARDE
}

model MilkProduction {
  id        String          @id @default(cuid())
  animalId  String
  animal    LivestockAnimal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  date      DateTime
  shift     MilkShift?
  liters    Decimal         @db.Decimal(6, 2)
  ccs       Decimal?        @db.Decimal(10, 2)
  cbt       Decimal?        @db.Decimal(10, 2)
  notes     String?
  createdAt DateTime        @default(now())

  @@map("milk_productions")
}

enum FeedingType {
  PASTO
  CONFINAMENTO
  SEMI_CONFINAMENTO
}

model LivestockFeeding {
  id              String      @id @default(cuid())
  loteId          String
  lote            Lote        @relation(fields: [loteId], references: [id], onDelete: Cascade)
  date            DateTime
  type            FeedingType @default(PASTO)
  silagemKg       Decimal?    @db.Decimal(8, 2)
  suplementacaoKg Decimal?    @db.Decimal(8, 2)
  consumoKg       Decimal?    @db.Decimal(8, 2)
  custoDiario     Decimal?    @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime    @default(now())

  @@map("livestock_feedings")
}

enum ManagementMovementType {
  MOVIMENTACAO
  EMBARQUE
  COMPRA
  VENDA
}

model ManagementMovement {
  id               String                 @id @default(cuid())
  animalId         String?
  animal           LivestockAnimal?       @relation(fields: [animalId], references: [id])
  loteId           String?
  lote             Lote?                  @relation(fields: [loteId], references: [id])
  type             ManagementMovementType
  date             DateTime
  origin           String?
  destination      String?
  value            Decimal?               @db.Decimal(12, 2)
  counterpartyName String?
  notes            String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())

  @@map("management_movements")
}

// ---------- Agricultura ----------

model Talhao {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String?
  areaHectares Decimal? @db.Decimal(10, 2)
  soilType     String?
  coordinates  String?
