  origemPropagulo            OrigemPropagulo @default(SEMENTEIRA_PROPRIA)
  numeroNotaCertificado      String?
  quantidadeInicial          Int
  quantidadeAtual            Int
  faseAtual                  FaseMuda        @default(SEMEADURA_ESTAQUEAMENTO)
  substrato                  String?
  recipiente                 String?
  status                     MudaLoteStatus  @default(ATIVO)
  previsaoConclusao          DateTime?
  notes                      String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  viveiroId String
  viveiro   Viveiro @relation(fields: [viveiroId], references: [id])

  responsavelId String?
  responsavel   Employee? @relation(fields: [responsavelId], references: [id])

  faseEventos    MudaFaseEvento[]
  insumos        MudaLoteInsumo[]
  irrigacoes     MudaLoteIrrigacao[]
  fitossanidades MudaLoteFitossanidade[]
  maoDeObra      MudaLoteMaoDeObra[]

  @@unique([organizationId, code])
  @@map("muda_lotes")
}

model MudaFaseEvento {
  id                String    @id @default(cuid())
  loteId            String
  lote              MudaLote  @relation(fields: [loteId], references: [id], onDelete: Cascade)
  fase              FaseMuda
  dataEntrada       DateTime  @default(now())
  dataSaida         DateTime?
  quantidadePerdida Int?      @default(0)
  notes             String?
  createdAt         DateTime  @default(now())

  @@map("muda_fase_eventos")
}

// ---------- Viveiro de Mudas: fase 2 (insumos, irrigação, fitossanidade, mão de obra) ----------

model MudaLoteInsumo {
  id          String    @id @default(cuid())
  loteId      String
  lote        MudaLote  @relation(fields: [loteId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  quantidade  Decimal   @db.Decimal(10, 2)
  // Custo unitário no momento do consumo — base do cálculo de custo por lote da fase 3.
  unitCost    Decimal?  @db.Decimal(10, 2)
  data        DateTime  @default(now())
  notes       String?
  createdAt   DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("muda_lote_insumos")
}

model MudaLoteIrrigacao {
  id             String    @id @default(cuid())
  loteId         String
  lote           MudaLote  @relation(fields: [loteId], references: [id], onDelete: Cascade)
  data           DateTime  @default(now())
  // Texto livre (ex.: gotejo/aspersão/manual) — mesmo padrão de Viveiro.sistemaIrrigacao.
  metodo         String?
  duracaoMinutos Int?
  responsavelId  String?
  responsavel    Employee? @relation(fields: [responsavelId], references: [id])
  notes          String?
  createdAt      DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("muda_lote_irrigacoes")
}

enum MudaFitossanidadeTipo {
  PRAGA
  DOENCA
  TRATAMENTO_PREVENTIVO
}

model MudaLoteFitossanidade {
  id              String                @id @default(cuid())
  loteId          String
  lote            MudaLote              @relation(fields: [loteId], references: [id], onDelete: Cascade)
  data            DateTime              @default(now())
  tipo            MudaFitossanidadeTipo
  produtoAplicado String?
  dosagem         String?
  responsavelId   String?
  responsavel     Employee?             @relation(fields: [responsavelId], references: [id])
  notes           String?
  createdAt       DateTime              @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("muda_lote_fitossanidades")
}

model MudaLoteMaoDeObra {
  id               String   @id @default(cuid())
  loteId           String
  lote             MudaLote @relation(fields: [loteId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id])
  data             DateTime @default(now())
  atividade        String
  horasTrabalhadas Decimal  @db.Decimal(5, 2)
  // Valor/hora no momento do apontamento — base do cálculo de custo por lote da fase 3.
  custoHora        Decimal? @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("muda_lote_mao_de_obras")
}

// ---------- Laboratório Agrícola ----------

enum ProdutorTipo {
  PRODUTOR_RURAL
  COOPERATIVA
  EMPRESA
  CONSULTOR_AGRONOMICO
}

model Produtor {
  id                     String       @id @default(cuid())
  name                   String
  cpfCnpj                String?
  tipo                   ProdutorTipo @default(PRODUTOR_RURAL)
  inscricaoEstadual      String?
  numeroProdutorRural    String?
  phone                  String?
  email                  String?
  address                String?
  city                   String?
  state                  String?
  responsavelTecnicoNome String?
  responsavelTecnicoCrea String?
  notes                  String?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  propriedades   PropriedadeProdutor[]
  laudosTecnicos LaudoTecnico[]
  pedidosAnalise PedidoAnalise[]

  @@map("produtores")
}

model PropriedadeProdutor {
  id          String   @id @default(cuid())
  name        String
  latitude    Decimal? @db.Decimal(10, 6)
  longitude   Decimal? @db.Decimal(10, 6)
  areaTotalHa Decimal? @db.Decimal(10, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  produtorId String
  produtor   Produtor @relation(fields: [produtorId], references: [id], onDelete: Cascade)

  talhoes    TalhaoProdutor[]
  amostras   Amostra[]
  auditorias AuditoriaAgricola[]

  @@map("propriedades_produtor")
}

model TalhaoProdutor {
  id                String   @id @default(cuid())
  code              String
  areaHa            Decimal? @db.Decimal(10, 2)
  culturaImplantada String?
  tipoSolo          String?
  historicoUso      String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  propriedadeProdutorId String
  propriedadeProdutor   PropriedadeProdutor @relation(fields: [propriedadeProdutorId], references: [id], onDelete: Cascade)

  amostras Amostra[]

  @@map("talhoes_produtor")
}

enum RegistroProfissionalTipo {
  CREA
  CRQ
  OUTRO
}

model ResponsavelTecnico {
  id                   String                   @id @default(cuid())
  registroProfissional String
  tipoRegistro         RegistroProfissionalTipo @default(CREA)
  setor                String?
  assinaturaDigitalRef String?
  active               Boolean                  @default(true)
  notes                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  laudosAssinados LaudoTecnico[]

  @@map("responsaveis_tecnicos")
}

enum AmostraTipo {
  SOLO
  FOLHA
  AGUA
  ADUBO
  SEMENTE
  TECIDO_VEGETAL
  RESIDUO
}

enum CondicaoRecebimento {
  INTEGRA
  VIOLADA
  REFRIGERADA
  OUTRO
}

enum AmostraStatus {
  RECEBIDA
  EM_ANALISE
  CONCLUIDA
  CANCELADA
}

model Amostra {
  id                    String               @id @default(cuid())
  code                  String
  tipo                  AmostraTipo
  dataColeta            DateTime
  profundidadeColeta    String?
  responsavelColetaNome String?
  metodoColeta          String?
  dataRecebimento       DateTime?
  condicaoRecebimento   CondicaoRecebimento?
  numeroSubAmostras     Int?
  status                AmostraStatus        @default(RECEBIDA)
  prazoEntregaPrevisto  DateTime?
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  propriedadeProdutorId String
  propriedadeProdutor   PropriedadeProdutor @relation(fields: [propriedadeProdutorId], references: [id])

  talhaoProdutorId String?
  talhaoProdutor   TalhaoProdutor? @relation(fields: [talhaoProdutorId], references: [id])

  custodiaEventos CadeiaCustodiaEvento[]
  resultados      Resultado[]
  laudos          LaudoAmostra[]
  itensPedido     PedidoAnaliseItem[]

  @@unique([organizationId, code])
  @@map("amostras")
}

enum CustodiaLocal {
  RECEPCAO
  SETOR_ANALISE
  ARQUIVO
  OUTRO
}

model CadeiaCustodiaEvento {
  id                       String        @id @default(cuid())
  amostraId                String
  amostra                  Amostra       @relation(fields: [amostraId], references: [id], onDelete: Cascade)
  dataHora                 DateTime      @default(now())
  responsavelMovimentacao  String?
  local                    CustodiaLocal @default(RECEPCAO)
  temperaturaArmazenamento Decimal?      @db.Decimal(5, 2)
  notes                    String?
  createdAt                DateTime      @default(now())

  @@map("cadeia_custodia_eventos")
}

// ---------- Laboratório Agrícola: fase 2 (métodos, equipamentos, resultados, QC) ----------

model MetodoAnalitico {
  id                    String   @id @default(cuid())
  nomeParametro         String
  referenciaNormativa   String?
  unidadeMedida         String?
  faixaDeteccaoMin      Decimal? @db.Decimal(12, 4)
  faixaDeteccaoMax      Decimal? @db.Decimal(12, 4)
  incertezaMedicao      Decimal? @db.Decimal(12, 4)
  tempoMedioAnaliseDias Int?
  acreditado            Boolean  @default(false)
  active                Boolean  @default(true)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  resultados       Resultado[]
  normasReferencia NormaReferencia[]

  @@map("metodos_analiticos")
}

enum EquipamentoStatus {
  EM_USO
  MANUTENCAO
  FORA_OPERACAO
}

model Equipamento {
  id                       String            @id @default(cuid())
  nome                     String
  modelo                   String?
  numeroSerie              String?
  dataUltimaCalibracao     DateTime?
  dataProximaCalibracao    DateTime?
  certificadoCalibracaoUrl String?
  responsavelCalibracao    String?
  status                   EquipamentoStatus @default(EM_USO)
  notes                    String?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  manutencoes EquipamentoManutencao[]
  resultados  Resultado[]

  @@map("equipamentos_lab")
}

model EquipamentoManutencao {
  id            String      @id @default(cuid())
  equipamentoId String
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  data          DateTime    @default(now())
  descricao     String?
  responsavel   String?
  createdAt     DateTime    @default(now())

  @@map("equipamento_manutencoes")
}

enum ResultadoStatus {
  PENDENTE
  VALIDADO
  REPROVADO
}

model Resultado {
  id          String          @id @default(cuid())
  valor       Decimal         @db.Decimal(14, 4)
  dataAnalise DateTime
  repeticoes  Int?
  status      ResultadoStatus @default(PENDENTE)
  observacoes String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  amostraId String
  amostra   Amostra @relation(fields: [amostraId], references: [id], onDelete: Cascade)

  metodoAnaliticoId String
  metodoAnalitico   MetodoAnalitico @relation(fields: [metodoAnaliticoId], references: [id])

  analistaId String?
  analista   Employee? @relation(fields: [analistaId], references: [id])

  equipamentoId String?
  equipamento   Equipamento? @relation(fields: [equipamentoId], references: [id])

  loteReagenteId String?
  loteReagente   StockBatch? @relation(fields: [loteReagenteId], references: [id])

  controlesQualidade ControleQualidade[]
  naoConformidades   NaoConformidade[]

  @@map("resultados")
}

enum ControleQualidadeTipo {
  BRANCO
  DUPLICATA
  PADRAO_REFERENCIA_CRM
  OUTRO
}

enum ControleQualidadeResultado {
  DENTRO_FAIXA
  FORA_FAIXA
}

model ControleQualidade {
  id                String                     @id @default(cuid())
  tipo              ControleQualidadeTipo
  valorObtido       Decimal?                   @db.Decimal(14, 4)
  faixaAceitavelMin Decimal?                   @db.Decimal(14, 4)
  faixaAceitavelMax Decimal?                   @db.Decimal(14, 4)
  resultadoControle ControleQualidadeResultado
  acaoCorretiva     String?
  data              DateTime                   @default(now())
  notes             String?
  createdAt         DateTime                   @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  resultadoId String
  resultado   Resultado @relation(fields: [resultadoId], references: [id], onDelete: Cascade)

  @@map("controles_qualidade")
}

// ---------- Laboratório Agrícola: fase 3 (laudos, normas, faturamento, acreditação) ----------

model NormaReferencia {
  id           String    @id @default(cuid())
  nome         String
  limiteLegal  String?
  dataVigencia DateTime?
  versao       String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  metodoAnaliticoId String?
  metodoAnalitico   MetodoAnalitico? @relation(fields: [metodoAnaliticoId], references: [id])

  @@map("normas_referencia")
}

enum LaudoStatus {
  RASCUNHO
  EMITIDO
  CANCELADO
  REEMITIDO
}

model LaudoTecnico {
  id                          String      @id @default(cuid())
  numero                      String
  dataEmissao                 DateTime?
  interpretacaoAgronomica     String?
  recomendacaoCalagemAdubacao String?
  templateUtilizado           String?
  versao                      Int         @default(1)
  status                      LaudoStatus @default(RASCUNHO)
  dataValidade                DateTime?
  pdfUrl                      String?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  produtorId String
  produtor   Produtor @relation(fields: [produtorId], references: [id])

  responsavelAssinanteId String
  responsavelAssinante   ResponsavelTecnico @relation(fields: [responsavelAssinanteId], references: [id])

  amostras LaudoAmostra[]

  @@unique([organizationId, numero])
  @@map("laudos_tecnicos")
}

model LaudoAmostra {
  id        String       @id @default(cuid())
  laudoId   String
  laudo     LaudoTecnico @relation(fields: [laudoId], references: [id], onDelete: Cascade)
  amostraId String
  amostra   Amostra      @relation(fields: [amostraId], references: [id])

  @@unique([laudoId, amostraId])
  @@map("laudo_amostras")
}

enum PedidoAnaliseStatusFinanceiro {
  PENDENTE
  PAGO
  VENCIDO
}

model PedidoAnalise {
  id               String                        @id @default(cuid())
  numero           String
  valorTotal       Decimal?                      @db.Decimal(12, 2)
  formaPagamento   String?
  statusFinanceiro PedidoAnaliseStatusFinanceiro @default(PENDENTE)
  notaFiscalUrl    String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  produtorId String
  produtor   Produtor @relation(fields: [produtorId], references: [id])

  itens PedidoAnaliseItem[]

  @@unique([organizationId, numero])
  @@map("pedidos_analise")
}

model PedidoAnaliseItem {
  id              String        @id @default(cuid())
  pedidoAnaliseId String
  pedidoAnalise   PedidoAnalise @relation(fields: [pedidoAnaliseId], references: [id], onDelete: Cascade)
  descricao       String
  valor           Decimal?      @db.Decimal(12, 2)
  amostraId       String?
  amostra         Amostra?      @relation(fields: [amostraId], references: [id])

  @@map("pedido_analise_itens")
}

model AcreditacaoLaboratorio {
  id                String    @id @default(cuid())
  escopoAcreditacao String?
  orgaoAcreditador  String?
  dataValidade      DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  auditorias AcreditacaoAuditoriaEvento[]

  @@map("acreditacoes_laboratorio")
}

model AcreditacaoAuditoriaEvento {
  id                       String                 @id @default(cuid())
  acreditacaoLaboratorioId String
  acreditacaoLaboratorio   AcreditacaoLaboratorio @relation(fields: [acreditacaoLaboratorioId], references: [id], onDelete: Cascade)
  data                     DateTime               @default(now())
  resultado                String?
  notes                    String?
  createdAt                DateTime               @default(now())

  @@map("acreditacao_auditoria_eventos")
}

// ---------- Auditoria Agrícola (módulo separado, fase 4/4 do Laboratório) ----------
// Audita a PROPRIEDADE do produtor (certificação GLOBALG.A.P., orgânico, BPA
// etc.) — não a amostra. Reaproveita PropriedadeProdutor/Produtor/Resultado
// do Laboratório em vez de duplicar cadastro.

enum AuditoriaTipo {
  INTERNA
  GLOBALGAP
  ORGANICO
  RAINFOREST_ALLIANCE
  BPA
  OUTRO
}

enum AuditoriaStatus {
  EM_ANDAMENTO
  APROVADA
  REPROVADA
  PENDENTE_ACAO
}

model AuditoriaAgricola {
  id                       String          @id @default(cuid())
  tipo                     AuditoriaTipo
  dataAuditoria            DateTime
  auditorNome              String?
  checklistNormaReferencia String?
  status                   AuditoriaStatus @default(EM_ANDAMENTO)
  dataReavaliacao          DateTime?
  certificadoGeradoUrl     String?
  certificadoValidade      DateTime?
  notes                    String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  propriedadeProdutorId String
  propriedadeProdutor   PropriedadeProdutor @relation(fields: [propriedadeProdutorId], references: [id])

  itens            ChecklistItem[]
  naoConformidades NaoConformidade[]

  @@map("auditorias_agricolas")
}

enum ConformidadeStatus {
  CONFORME
  NAO_CONFORME
  NAO_APLICAVEL
}

model ChecklistItem {
  id           String             @id @default(cuid())
  auditoriaId  String
  auditoria    AuditoriaAgricola  @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  descricao    String
  conformidade ConformidadeStatus @default(NAO_APLICAVEL)
  evidenciaUrl String?
  notes        String?
  createdAt    DateTime           @default(now())

  @@map("checklist_itens")
}

enum NaoConformidadeOrigem {
  ANALISE_LABORATORIAL
  AUDITORIA
}

enum NaoConformidadeSeveridade {
  CRITICA
  MAIOR
  MENOR
}

enum NaoConformidadeStatus {
  ABERTA
  EM_TRATATIVA
  RESOLVIDA
}

model NaoConformidade {
  id                          String                    @id @default(cuid())
  origem                      NaoConformidadeOrigem
  descricao                   String
  severidade                  NaoConformidadeSeveridade
  responsavelInvestigacaoNome String?
  causaRaiz                   String?
  acaoCorretivaPreventiva     String?
  prazoResolucao              DateTime?
  status                      NaoConformidadeStatus     @default(ABERTA)
  reincidente                 Boolean                   @default(false)
  notes                       String?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  auditoriaId String?
  auditoria   AuditoriaAgricola? @relation(fields: [auditoriaId], references: [id])

  resultadoId String?
  resultado   Resultado? @relation(fields: [resultadoId], references: [id])

  @@map("nao_conformidades")
}

// ---------- Log de Auditoria ----------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  userName   String?
  action     AuditAction
  entityType String
  entityId   String
  changes    Json?
  createdAt  DateTime    @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ---------- Notificações ----------

enum NotificationSeverity {
  VENCIDO
  VENCENDO
}

model Notification {
  id        String               @id @default(cuid())
  category  String
  title     String
  detail    String?
  href      String?
  severity  NotificationSeverity
  sourceKey String
  read      Boolean              @default(false)
  createdAt DateTime             @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sourceKey])
  @@index([organizationId, read, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("push_subscriptions")
}

// ---------- API pública (somente leitura) ----------

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyPrefix  String
  keyHash    String    @unique
  lastUsedAt DateTime?
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("api_keys")
}

// ---------- Convite e redefinição de senha ----------

enum PasswordResetTokenKind {
  INVITE
  RESET
}

model PasswordResetToken {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String                 @unique
  kind      PasswordResetTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime               @default(now())

  @@map("password_reset_tokens")
}
