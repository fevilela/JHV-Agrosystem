DATABASE_URL="postgresql://user:password@host:5432/dbname"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Resend da PLATAFORMA (JHV) — só pros e-mails de sistema (convite de senha e
# redefinição de senha). Não é o mesmo Resend por organização (resendApiKey/
# resendFromEmail no banco, configurado em /admin/[id]), que continua sendo usado
# só pros e-mails de negócio (boleto/contrato) de cada organização.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="sistema@jhvagrosystem.com.br"

# Supabase Storage (fotos/documentos de animais) — mesmo projeto do DATABASE_URL. A service
# role key ignora RLS e só deve ser usada server-side (nunca no client). Ver docs/DEPLOY.md pro
# passo manual de criar o bucket "uploads" público no painel do Supabase.
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx"
MERCADOPAGO_PUBLIC_KEY="APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MERCADOPAGO_CLIENT_ID="xxxxxxxxxxxxxxx"
MERCADOPAGO_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

CRON_SECRET="generate-with-openssl-rand-hex-32"

WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="notificacao_boleto"

WHATSAPP_WEBHOOK_VERIFY_TOKEN="generate-with-openssl-rand-hex-24"

# Gerar com: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@jhvagrosystem.com.br"
